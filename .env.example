# Supabase Configuration
# Replace with your project details from Supabase Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# REQUIRED on a live site. The server reads and writes all data with this
# key; supabase/migration-lockdown.sql then removes the public key's access.
# Supabase → Project settings → API keys → service_role. Never expose it to
# the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Signs the sign-in cookie so it cannot be edited (lib/session-token.ts).
# Use a long random string, e.g. the output of: openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# Temporary escape hatch ONLY. With Supabase configured, the old shared
# passwords (Seller@2026, Employee@2026, …) no longer open accounts. Set to
# true just long enough to set real passwords from /admin/accounts.
# ALLOW_SHARED_PASSWORDS=false

# AI suggestions (✨ category & attributes, admin category filing) — optional.
# Alibaba Cloud Model Studio → API Keys. The key belongs to one region; the
# default endpoint is International (Singapore). See lib/ai.ts.
# DASHSCOPE_API_KEY=sk-...
# QWEN_MODEL=qwen3.7-plus          # or qwen3.7-flash: cheaper, faster
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#
# Anthropic instead (used when DASHSCOPE_API_KEY is not set):
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=alibaba              # only needed when both keys are set
