# Supabase Configuration
# Replace with your project details from Supabase Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key for server-side administrative tasks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Signs the sign-in cookie so it cannot be edited (lib/session-token.ts).
# Use a long random string, e.g. the output of: openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string
